# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://localhost:27017/college_attendance

# Authentication & Security
JWT_SECRET=supersecretjwtkey_replace_in_production_min32chars
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Dynamic QR Code Expiration (e.g. 30s)
QR_TOKEN_EXPIRES_IN=30s
